<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NOOS</vendor>
  <vendor_url>https://github.com/Chomiam/noos-de</vendor_url>
  <action id="org.noos.share.helper">
    <description>Configure file sharing on the local network</description>
    <description xml:lang="fr">Configurer le partage de fichiers sur le réseau local</description>
    <message>Authentication is required to change file sharing (Samba, SSH, WebDAV)</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier le partage de fichiers (Samba, SSH, WebDAV)</message>
    <icon_name>folder-remote</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/noos/libexec/noos-share-helper</annotate>
  </action>
</policyconfig>
