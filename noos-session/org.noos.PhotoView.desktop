[Desktop Entry]
Name=Photos
GenericName=Visionneuse d'images
Comment=Afficher vos photos et images : zoom, diaporama, informations
Exec=noos-photoview %U
Icon=multimedia-photo-viewer
Terminal=false
Type=Application
Categories=GTK;Graphics;Viewer;Photography;
Keywords=photo;image;visionneuse;viewer;diaporama;slideshow;jpeg;png;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/svg+xml;image/avif;image/heif;image/heic;image/jxl;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpixmap;image/qoi;
StartupWMClass=org.noos.PhotoView
