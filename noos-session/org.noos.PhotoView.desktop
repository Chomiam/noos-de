[Desktop Entry]
Name=Photos
GenericName=Visionneuse d'images
Comment=Afficher vos photos et images : zoom, diaporama, informations
Exec=noos-photoview %U
Icon=multimedia-photo-viewer
Terminal=false
Type=Application
Categories=GTK;Graphics;Viewer;Photography;
Keywords=photo;image;visionneuse;viewer;diaporama;slideshow;jpeg;png;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/svg+xml;image/avif;image/heif;image/heic;image/jxl;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpixmap;image/qoi;image/x-nikon-nef;image/x-nikon-nrw;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-adobe-dng;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-raw;image/x-pentax-pef;image/x-samsung-srw;image/x-minolta-mrw;image/x-sigma-x3f;image/x-kodak-dcr;image/x-kodak-kdc;image/x-dcraw;
StartupWMClass=org.noos.PhotoView
