[Desktop Entry]
Name=Terminal
Comment=Terminal NOOS : onglets, thèmes, alias (ex. claude)
Exec=noos-term
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=GTK;System;TerminalEmulator;
Keywords=terminal;console;shell;commande;claude;
StartupWMClass=org.noos.Terminal
Actions=new-window;

[Desktop Action new-window]
Name=Nouvelle fenêtre
Exec=noos-term
