[Desktop Entry]
Type=Application
Name=Archives
GenericName=Gestionnaire d'archives
Comment=Créer, parcourir et extraire des archives (zip, 7z, rar, tar, iso et plus de 60 formats)
Keywords=archive;zip;7z;rar;tar;compresser;extraire;décompresser;iso;
Icon=package-x-generic
Exec=noos-archive %F
Terminal=false
StartupNotify=true
Categories=Utility;Archiving;Compression;GTK;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/x-lzip-compressed-tar;application/x-lzma-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/x-xz;application/zstd;application/x-zstd;application/x-lz4;application/x-lzip;application/x-lzma;application/x-compress;application/x-cd-image;application/x-iso9660-image;application/x-apple-diskimage;application/x-ms-wim;application/vnd.ms-cab-compressed;application/x-cab;application/x-msi;application/x-rpm;application/vnd.debian.binary-package;application/x-deb;application/x-cpio;application/x-archive;application/x-arj;application/x-lha;application/x-lzh-compressed;application/x-xar;application/x-stuffit;application/x-stuffitx;application/x-alz;application/x-ace;application/x-zoo;application/x-squashfs;application/x-java-archive;application/vnd.android.package-archive;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cbz;application/x-cbr;application/x-cb7;application/x-raw-disk-image;application/x-qemu-disk;application/x-virtualbox-vdi;application/x-vhd;application/x-vhdx;application/x-vmdk;
Actions=new;

[Desktop Action new]
Name=Créer une archive
Exec=noos-archive --compress
