#!/bin/sh
# Paquet noos : réglages faits une seule fois (repères dans /var/lib/noos) pour respecter les
# choix ultérieurs de l'utilisateur, et mises à jour des thèmes à chaque installation.
set -e

if [ "$1" = configure ]; then
    mkdir -p /var/lib/noos
    ldconfig || true

    # Architecture 32 bits (Steam, Wine) : Debian ne l'active pas par défaut.
    if [ ! -e /var/lib/noos/i386 ]; then
        if ! dpkg --print-foreign-architectures | grep -qx i386; then
            dpkg --add-architecture i386 || true
        fi
        touch /var/lib/noos/i386
    fi

    # Flathub actif par défaut (fichier embarqué : pas de réseau). Si l'utilisateur retire
    # Flathub, une mise à jour ne le remet pas.
    if [ ! -e /var/lib/noos/flathub-added ] && command -v flatpak >/dev/null 2>&1; then
        flatpak remote-add --system --if-not-exists flathub /opt/noos/share/noos/flathub.flatpakrepo >/dev/null 2>&1 || true
        flatpak remote-modify --system --no-filter --enable flathub >/dev/null 2>&1 || true
        touch /var/lib/noos/flathub-added
    fi

    # Instantanés Btrfs de / (snapper) : configurés si la racine est en Btrfs ; les réglages
    # choisis ensuite dans « Sauvegarder et Restaurer » sont conservés aux mises à jour.
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$(findmnt -no FSTYPE / 2>/dev/null)" = btrfs ]; then
        /opt/noos/libexec/noos-save-helper setup >/dev/null 2>&1 || true
    fi

    # Pare-feu NOOS, activé une seule fois (l'utilisateur peut l'arrêter). Le service est en
    # conflit avec ufw / firewalld (systemd les arrête au démarrage de noos-firewall) ; sans
    # fenêtre d'autorisation connectée, les sorties restent autorisées (session en cours intacte).
    if [ ! -e /var/lib/noos/firewall ]; then
        systemctl enable noos-firewall.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl start noos-firewall.service >/dev/null 2>&1 || true
        fi
        touch /var/lib/noos/firewall
    elif [ -d /run/systemd/system ] && systemctl is-active --quiet noos-firewall.service; then
        # Mise à jour : nouveau démon.
        systemctl restart noos-firewall.service >/dev/null 2>&1 || true
    fi

    # Partage de fichiers, une seule fois (/etc/noos/sharing.toml) : dossier personnel partagé
    # sur le réseau local, avec authentification (mot de passe de partage choisi ensuite par
    # l'utilisateur dans Paramètres : sans lui, personne ne peut se connecter). Un serveur SSH
    # déjà utilisé garde son état ; un openssh-server qui vient d'arriver reste désactivé.
    if [ ! -e /var/lib/noos/sharing ]; then
        /opt/noos/libexec/noos-share-helper init >/dev/null 2>&1 || true
        touch /var/lib/noos/sharing
    fi

    # Profils d'énergie, une seule fois (l'utilisateur peut les couper).
    if [ ! -e /var/lib/noos/power-profiles ]; then
        systemctl enable power-profiles-daemon.service >/dev/null 2>&1 || true
        touch /var/lib/noos/power-profiles
    fi

    # Nouveaux comptes (useradd) : fish par défaut, une seule fois.
    if [ ! -e /var/lib/noos/useradd-fish ] && [ -x /usr/bin/fish ] && [ -f /etc/default/useradd ]; then
        if grep -q '^SHELL=' /etc/default/useradd; then
            sed -i 's|^SHELL=.*|SHELL=/usr/bin/fish|' /etc/default/useradd
        else
            echo 'SHELL=/usr/bin/fish' >>/etc/default/useradd
        fi
        touch /var/lib/noos/useradd-fish
    fi

    # Recherche régulière des mises à jour (timer utilisateur), une seule fois.
    if [ ! -e /var/lib/noos/update-timer ]; then
        systemctl --global enable noos-update-check.timer >/dev/null 2>&1 || true
        touch /var/lib/noos/update-timer
    fi

    # Écran de connexion sur la console 1 (voir greetd.service.d/90-noos-vt1.conf) : les
    # installations faites avec vt = 7 restaient bloquées sur la console texte au démarrage.
    if grep -q noos-greeter /etc/greetd/config.toml 2>/dev/null && grep -q '^vt *= *7' /etc/greetd/config.toml; then
        sed -i 's/^vt *= *7/vt = 1/' /etc/greetd/config.toml
    fi

    # noos.sources écrit par l'installateur (même dépôt, commentaire différent) : dpkg a gardé
    # celui du paquet à côté. Copie inutile, retirée si le fichier en place vise bien NOOS.
    s=/etc/apt/sources.list.d/noos.sources
    if [ -f "$s.dpkg-dist" ] && grep -q 'chomiam.github.io/noos-de' "$s" 2>/dev/null; then
        rm -f "$s.dpkg-dist"
    fi

    # Écran de connexion : répertoire d'état du greeter (compte _greetd du paquet greetd).
    if getent passwd _greetd >/dev/null 2>&1; then
        install -d -o _greetd -g _greetd /var/lib/noos-login 2>/dev/null || true
    fi

    # Démarrage fluide : pilote graphique chargé tôt, Plymouth NOOS sans simpledrm
    # (initramfs régénéré seulement si ces réglages changent).
    /usr/libexec/noos-boot-setup >/dev/null 2>&1 || true

    # Thème GRUB : fichiers mis à jour à chaque fois ; grub.cfg régénéré à la première installation.
    if [ -d /boot/grub ]; then
        if grep -q '^GRUB_THEME=' /etc/default/grub 2>/dev/null; then
            /usr/share/noos-grub/install.sh >/dev/null 2>&1 || true
        else
            /usr/share/noos-grub/install.sh --mkconfig >/dev/null 2>&1 || true
        fi
    fi
fi

#DEBHELPER#

exit 0
