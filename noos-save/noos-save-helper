#!/usr/bin/env bash
# noos-save-helper — partie privilégiée de « Sauvegarder et Restaurer » (noos-save).
# Lancé en root : par pkexec depuis l'application (polkit org.noos.save.helper), par apt
# (crochets DPkg::Pre-Invoke / Post-Invoke de /etc/apt/apt.conf.d/80noos-save), par
# l'installateur et par le paquet Debian.
#
#   setup                     configure snapper pour / (Btrfs) : config « root », nettoyage
#   create <description>      instantané manuel (jamais supprimé automatiquement)
#   delete <n>…               supprime des instantanés
#   set <CLÉ> <valeur>        réglage snapper (liste blanche ci-dessous)
#   apt on|off                instantanés avant / après chaque opération apt
#   rollback <n>              restaure l'instantané n au prochain redémarrage
#   cancel                    annule la restauration en attente
#   delete-old <nom>          supprime une ancienne racine (@.avant-restauration-…)
#   describe <n> <texte>      renomme un instantané
#   keep <n> yes|no           « à conserver » : jamais supprimé par le nettoyage automatique
#   grub on|off|refresh       sous-menu « Restaurer depuis un instantané » du démarrage
#   grub-max <n>              nombre d'instantanés dans ce sous-menu
#   snapshot-boot             (service au démarrage sur un instantané) monte /.snapshots
#   apt-pre / apt-post        appelés par apt (80noos-save), jamais en échec
#
# Disposition attendue (installateur NOOS) : racine = sous-volume @ monté par son nom
# (fstab et rootflags=subvol=@), /home = @home, /boot séparé. `snapper rollback` change le
# sous-volume par défaut, sans effet ici : la restauration remplace donc @ lui-même.
set -euo pipefail
export LC_ALL=C.UTF-8 PATH=/usr/sbin:/usr/bin:/sbin:/bin

CONF=/etc/noos/save.conf
STATE=/var/lib/noos-save
SNAPPER=(snapper --no-dbus -c root)

die() { echo "noos-save : $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "à lancer en root"; }
in_chroot() { systemd-detect-virt --quiet --chroot 2>/dev/null; }
configured() { [ -e /etc/snapper/configs/root ]; }
is_number() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

# Démarrage sur un instantané (entrée GRUB « Restaurer depuis un instantané ») : la racine est
# alors un overlay en mémoire sur l'instantané en lecture seule ; /home reste sur le même Btrfs.
snapshot_boot() { sed -n 's/.*noos\.snapshot=\([0-9]*\).*/\1/p' /proc/cmdline; }
root_device() {
    if [ "$(findmnt -no FSTYPE /)" = btrfs ]; then
        findmnt -no SOURCE / | sed 's/\[.*//'
    else
        findmnt -no SOURCE -T /home | sed 's/\[.*//'
    fi
}
btrfs_root() { [ "$(findmnt -no FSTYPE /)" = btrfs ] || { [ -n "$(snapshot_boot)" ] && [ "$(findmnt -no FSTYPE -T /home)" = btrfs ]; }; }
root_subvol() { findmnt -no OPTIONS / | tr ',' '\n' | sed -n 's|^subvol=/\{0,1\}||p'; }

# Monte la racine du système de fichiers Btrfs (subvolid=5) dans $TOP.
TOP=""
mount_top() {
    btrfs_root || die "la racine n'est pas en Btrfs"
    [ "$(root_subvol)" = "@" ] || [ -e "$STATE/pending" ] || [ -n "$(snapshot_boot)" ] || die "racine inattendue ($(root_subvol)) : seule la disposition @ est gérée"
    TOP=$(mktemp -d /run/noos-save.XXXXXX)
    mount -o subvolid=5 "$(root_device)" "$TOP"
    trap 'umount "$TOP" 2>/dev/null; rmdir "$TOP" 2>/dev/null' EXIT
}

GRUB_CFG=/boot/grub/grub.cfg

# Entrée GRUB (identifiant « gnulinux-<version>-advanced-<uuid> » de 10_linux, Debian) d'un noyau.
grub_entry_for() {
    grep -o "gnulinux-$1-advanced-[0-9a-fA-F-]*" "$GRUB_CFG" 2>/dev/null | head -1
}

# Entrée de démarrage par défaut (GRUB_DEFAULT=saved, réglé par l'installateur).
set_default_kernel() {
    local id
    id=$(grub_entry_for "$1")
    if [ -n "$id" ] && command -v grub-set-default >/dev/null; then
        grub-set-default "$id"
    else
        # Pas d'entrée nommée (GRUB_DEFAULT ≠ saved, grub.cfg ancien) : première entrée.
        command -v grub-set-default >/dev/null && grub-set-default 0 || true
    fi
}

# Noyau par défaut : le plus récent dont les modules existent dans la racine $1.
set_kernel_for() {
    local modules="$1/usr/lib/modules" best=""
    for v in $(ls /boot | sed -n 's/^vmlinuz-\(.*\)$/\1/p' | sort -V); do
        [ -d "$modules/$v" ] && [ -f "/boot/initrd.img-$v" ] && best="$v"
    done
    [ -n "$best" ] || return 1
    set_default_kernel "$best" >/dev/null
    echo "$best"
}

conf_get() { [ -f "$CONF" ] && sed -n "s/^$1=//p" "$CONF" | tail -1; }
grub_refresh() {
    in_chroot && return 0
    [ -n "$(snapshot_boot)" ] && return 0
    command -v grub-mkconfig >/dev/null || return 0
    grub-mkconfig -o "$GRUB_CFG" >/dev/null 2>&1
}

# Commande apt à l'origine de l'opération (ancêtre apt / apt-get / aptitude / noos-pkg du
# crochet), pour décrire l'instantané : « apt-get -y install git ».
apt_command() {
    local pid=$PPID i cmd
    for i in 1 2 3 4 5 6; do
        [ -r "/proc/$pid/cmdline" ] || break
        cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | sed 's/ *$//')
        case "$(basename "$(readlink "/proc/$pid/exe" 2>/dev/null)")" in
        apt | apt-get | aptitude | unattended-upgrade | python3*) echo "${cmd:0:200}"; return ;;
        esac
        pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null) || break
        [ "$pid" -gt 1 ] 2>/dev/null || break
    done
    echo apt
}

conf_set() {
    mkdir -p "$(dirname "$CONF")"
    touch "$CONF"
    if grep -q "^$1=" "$CONF"; then sed -i "s|^$1=.*|$1=$2|" "$CONF"; else echo "$1=$2" >>"$CONF"; fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
describe)
    need_root
    is_number "${1:-}" && [ "$1" != 0 ] || die "numéro invalide"
    desc="${2:-}"
    [ -n "$desc" ] || die "nom attendu"
    "${SNAPPER[@]}" modify -d "${desc:0:200}" "$1"
    ;;
keep)
    need_root
    n="${1:-}"
    is_number "$n" && [ "$n" != 0 ] || die "numéro invalide"
    case "${2:-}" in
    yes) "${SNAPPER[@]}" modify -c "" --userdata "important=yes" "$n" ;;
    no)
        # Les instantanés apt retrouvent leur nettoyage automatique ; les manuels n'en ont pas.
        algo=""
        grep -A1 '<key>noos</key>' "/.snapshots/$n/info.xml" 2>/dev/null | grep -q '>apt<' && algo=number
        "${SNAPPER[@]}" modify -c "$algo" --userdata "important=no" "$n"
        ;;
    *) die "yes ou no" ;;
    esac
    ;;
grub)
    need_root
    case "${1:-}" in
    on) conf_set GRUB_SNAPSHOTS yes ;;
    off) conf_set GRUB_SNAPSHOTS no ;;
    refresh) ;;
    *) die "on, off ou refresh" ;;
    esac
    grub_refresh || die "grub-mkconfig a échoué"
    ;;
grub-max)
    need_root
    is_number "${1:-}" && [ "$1" -ge 1 ] && [ "$1" -le 100 ] || die "valeur invalide"
    conf_set GRUB_SNAPSHOTS_MAX "$1"
    grub_refresh || die "grub-mkconfig a échoué"
    ;;
snapshot-boot)
    # Démarré sur un instantané : /.snapshots de l'instantané est vide (sous-volume imbriqué) ;
    # on y monte celui du système pour lister et restaurer depuis l'application.
    need_root
    [ -n "$(snapshot_boot)" ] || exit 0
    mountpoint -q /.snapshots && exit 0
    mkdir -p /.snapshots
    mount -o subvol=@/.snapshots "$(root_device)" /.snapshots
    ;;
setup)
    need_root
    [ "$(findmnt -no FSTYPE /)" = btrfs ] || die "la racine n'est pas en Btrfs : instantanés impossibles"
    if ! configured; then
        "${SNAPPER[@]}" create-config /
    fi
    # Membres de « sudo » (administrateurs Debian) : lecture de la liste sans mot de passe
    # (snapperd + ACL).
    "${SNAPPER[@]}" set-config ALLOW_GROUPS=sudo SYNC_ACL=yes NUMBER_CLEANUP=yes TIMELINE_CLEANUP=yes
    # Valeurs par défaut à la première configuration seulement (ensuite : choix de l'utilisateur).
    # Instantanés horaires désactivés : ceux d'apt et les manuels suffisent au quotidien.
    if [ "$(conf_get SETUP_DONE)" != yes ]; then
        "${SNAPPER[@]}" set-config NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 TIMELINE_CREATE=no \
            TIMELINE_LIMIT_HOURLY=5 TIMELINE_LIMIT_DAILY=7 TIMELINE_LIMIT_WEEKLY=2 TIMELINE_LIMIT_MONTHLY=1 \
            TIMELINE_LIMIT_YEARLY=0
    fi
    [ -n "$(conf_get APT_SNAPSHOTS)" ] || conf_set APT_SNAPSHOTS yes
    [ -n "$(conf_get GRUB_SNAPSHOTS)" ] || conf_set GRUB_SNAPSHOTS yes
    [ -n "$(conf_get GRUB_SNAPSHOTS_MAX)" ] || conf_set GRUB_SNAPSHOTS_MAX 20
    conf_set SETUP_DONE yes
    if in_chroot; then
        systemctl enable snapper-cleanup.timer snapper-timeline.timer >/dev/null 2>&1 || true
    else
        systemctl enable --now snapper-cleanup.timer snapper-timeline.timer >/dev/null 2>&1 || true
    fi
    systemctl enable noos-snapshots-grub.path noos-snapshot-boot.service >/dev/null 2>&1 || true
    in_chroot || systemctl start noos-snapshots-grub.path >/dev/null 2>&1 || true
    grub_refresh || true
    echo "instantanés configurés"
    ;;
create)
    need_root
    configured || die "instantanés non configurés"
    desc="${1:-Instantané manuel}"
    [ -z "$(snapshot_boot)" ] || die "impossible depuis un instantané démarré : restaurez-le d'abord"
    "${SNAPPER[@]}" create -t single -p -d "${desc:0:200}" --userdata "noos=manuel"
    ;;
delete)
    need_root
    [ $# -gt 0 ] || die "numéro attendu"
    for n in "$@"; do is_number "$n" && [ "$n" != 0 ] || die "numéro invalide : $n"; done
    "${SNAPPER[@]}" delete "$@"
    ;;
set)
    need_root
    key="${1:-}" value="${2:-}"
    case "$key" in
    TIMELINE_CREATE) [[ "$value" =~ ^(yes|no)$ ]] || die "valeur invalide" ;;
    NUMBER_LIMIT | NUMBER_LIMIT_IMPORTANT | TIMELINE_LIMIT_HOURLY | TIMELINE_LIMIT_DAILY | TIMELINE_LIMIT_WEEKLY | TIMELINE_LIMIT_MONTHLY | TIMELINE_LIMIT_YEARLY)
        is_number "$value" && [ "$value" -le 1000 ] || die "valeur invalide" ;;
    *) die "réglage non autorisé : $key" ;;
    esac
    "${SNAPPER[@]}" set-config "$key=$value"
    ;;
apt)
    need_root
    case "${1:-}" in on) conf_set APT_SNAPSHOTS yes ;; off) conf_set APT_SNAPSHOTS no ;; *) die "on ou off" ;; esac
    ;;
apt-pre)
    # Appelé par apt avant dpkg (DPkg::Pre-Invoke) : ne doit jamais faire échouer l'opération.
    # Le numéro de l'instantané « avant » est gardé dans /run pour apt-post.
    set +e
    [ "$(conf_get APT_SNAPSHOTS)" = no ] && exit 0
    [ -z "$(snapshot_boot)" ] || exit 0
    in_chroot && exit 0
    configured && ! [ -e "$STATE/pending" ] || exit 0
    what=$(apt_command)
    n=$("${SNAPPER[@]}" create -t pre -c number -p -d "${what:-apt}" --userdata "noos=apt" 2>/dev/null) || exit 0
    mkdir -p /run/noos-save
    printf '%s\n%s\n' "$n" "$what" >/run/noos-save/apt-pre
    exit 0
    ;;
apt-post)
    # Appelé par apt après dpkg (DPkg::Post-Invoke).
    set +e
    [ -f /run/noos-save/apt-pre ] || exit 0
    n=$(sed -n 1p /run/noos-save/apt-pre)
    what=$(sed -n 2p /run/noos-save/apt-pre)
    rm -f /run/noos-save/apt-pre
    is_number "$n" || exit 0
    "${SNAPPER[@]}" create -t post --pre-number "$n" -c number -d "${what:-apt}" --userdata "noos=apt" >/dev/null 2>&1
    exit 0
    ;;
rollback)
    need_root
    n="${1:-}"
    is_number "$n" && [ "$n" != 0 ] || die "numéro invalide"
    [ -e "$STATE/pending" ] && die "une restauration est déjà prévue : annulez-la d'abord"
    mount_top
    src="$TOP/@/.snapshots/$n/snapshot"
    [ -d "$src" ] || die "instantané $n introuvable"
    [ -d "$src/usr/lib/modules" ] || die "l'instantané $n ne contient pas de système complet"
    old="@.avant-restauration-$(date +%Y%m%d-%H%M%S)"
    # 1. Copie modifiable de l'instantané. 2. @ devient l'ancienne racine (le système en cours
    # reste monté par son identifiant et continue de fonctionner). 3. La copie devient @.
    # 4. Les instantanés suivent dans la nouvelle racine.
    btrfs subvolume snapshot "$src" "$TOP/@.noos-restauration" >/dev/null
    rmdir "$TOP/@.noos-restauration/.snapshots" 2>/dev/null || true
    mv "$TOP/@" "$TOP/$old"
    mv "$TOP/@.noos-restauration" "$TOP/@"
    mv "$TOP/$old/.snapshots" "$TOP/@/.snapshots"
    # Noyau : /boot n'est pas dans les instantanés ; on démarre le plus récent compatible.
    if ! kernel=$(set_kernel_for "$TOP/@"); then
        mv "$TOP/@/.snapshots" "$TOP/$old/.snapshots"
        btrfs subvolume delete "$TOP/@" >/dev/null
        mv "$TOP/$old" "$TOP/@"
        die "aucun noyau installé ne correspond à l'instantané $n : restauration annulée"
    fi
    mkdir -p "$STATE" "$TOP/@$STATE"
    printf 'SNAPSHOT=%s\nOLD=%s\nKERNEL=%s\nDATE=%s\n' "$n" "$old" "$kernel" "$(date -Iseconds)" >"$STATE/pending"
    printf 'SNAPSHOT=%s\nOLD=%s\nKERNEL=%s\nDATE=%s\n' "$n" "$old" "$kernel" "$(date -Iseconds)" >"$TOP/@$STATE/restored"
    echo "restauration de l'instantané $n au prochain redémarrage (noyau $kernel, ancienne racine $old)"
    ;;
cancel)
    need_root
    [ -e "$STATE/pending" ] || die "aucune restauration en attente"
    old=$(sed -n 's/^OLD=//p' "$STATE/pending")
    [[ "$old" =~ ^@\.avant-restauration-[0-9-]+$ ]] || die "état de restauration invalide"
    mount_top
    [ -d "$TOP/$old" ] || die "ancienne racine $old introuvable"
    mv "$TOP/@/.snapshots" "$TOP/$old/.snapshots"
    btrfs subvolume delete -R "$TOP/@" >/dev/null 2>&1 || btrfs subvolume delete "$TOP/@" >/dev/null
    mv "$TOP/$old" "$TOP/@"
    set_default_kernel "$(uname -r)" >/dev/null 2>&1 || true
    rm -f "$STATE/pending"
    echo "restauration annulée"
    ;;
delete-old)
    need_root
    name="${1:-}"
    [[ "$name" =~ ^@\.avant-restauration-[0-9-]+$ ]] || die "nom invalide"
    [ -e "$STATE/pending" ] && die "redémarrez d'abord pour terminer la restauration"
    mount_top
    [ -d "$TOP/$name" ] || die "$name introuvable"
    btrfs subvolume delete -R "$TOP/$name" >/dev/null 2>&1 || btrfs subvolume delete "$TOP/$name" >/dev/null
    sed -i '/^OLD=/d' "$STATE/restored" 2>/dev/null || true
    echo "$name supprimé"
    ;;
*)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
    [ -z "$cmd" ] || exit 2
    ;;
esac
