<?xml version="1.0" encoding="UTF-8"?>
<!-- Thème de coloration de NOOS (Éditeur de texte), assorti au terminal « NOOS sombre ». -->
<style-scheme id="noos-dark" name="NOOS sombre" version="1.0">
  <author>NOOS</author>
  <description>Couleurs de la palette NOOS</description>
  <color name="bg" value="#14151d"/>
  <color name="fg" value="#e3e5ee"/>
  <color name="bright" value="#f4f5fa"/>
  <color name="cursor" value="#8fb4ff"/>
  <color name="sel" value="#2b3a63"/>
  <color name="sel2" value="#232a40"/>
  <color name="line" value="#1b1d28"/>
  <color name="gutter" value="#14151d"/>
  <color name="dim" value="#5b6075"/>
  <color name="match" value="#2e3554"/>
  <color name="search" value="#5c4a17"/>
  <color name="margin" value="#262938"/>
  <color name="margin_bg" value="#171821"/>
  <color name="space" value="#343849"/>
  <color name="comment" value="#6d7391"/>
  <color name="red" value="#ef6f7d"/>
  <color name="green" value="#7fd6a1"/>
  <color name="yellow" value="#f0c674"/>
  <color name="orange" value="#ffb17a"/>
  <color name="blue" value="#7aa7ff"/>
  <color name="purple" value="#c79bff"/>
  <color name="cyan" value="#6fd3e0"/>
  <style name="text" foreground="fg" background="bg"/>
  <style name="selection" background="sel"/>
  <style name="selection-unfocused" background="sel2"/>
  <style name="cursor" foreground="cursor"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="dim" background="gutter"/>
  <style name="current-line-number" foreground="fg" background="line" bold="true"/>
  <style name="bracket-match" foreground="bright" background="match" bold="true"/>
  <style name="bracket-mismatch" foreground="red" underline="error"/>
  <style name="search-match" background="search"/>
  <style name="right-margin" foreground="margin" background="margin_bg"/>
  <style name="draw-spaces" foreground="space"/>
  <style name="background-pattern" background="line"/>
  <style name="snippet-focus" background="match"/>
  <style name="def:comment" foreground="comment" italic="true"/>
  <style name="def:shebang" foreground="comment" bold="true"/>
  <style name="def:doc-comment-element" foreground="comment" bold="true"/>
  <style name="def:string" foreground="green"/>
  <style name="def:special-char" foreground="cyan"/>
  <style name="def:character" foreground="green"/>
  <style name="def:keyword" foreground="purple" bold="true"/>
  <style name="def:statement" foreground="purple"/>
  <style name="def:type" foreground="cyan"/>
  <style name="def:function" foreground="blue"/>
  <style name="def:identifier" foreground="fg"/>
  <style name="def:constant" foreground="yellow"/>
  <style name="def:number" foreground="orange"/>
  <style name="def:boolean" foreground="orange" bold="true"/>
  <style name="def:builtin" foreground="red"/>
  <style name="def:preprocessor" foreground="red"/>
  <style name="def:operator" foreground="cyan"/>
  <style name="def:decimal" foreground="orange"/>
  <style name="def:floating-point" foreground="orange"/>
  <style name="def:special-constant" foreground="orange" bold="true"/>
  <style name="def:error" underline="error" underline-color="red"/>
  <style name="def:warning" underline="error" underline-color="yellow"/>
  <style name="def:note" foreground="yellow" bold="true"/>
  <style name="def:net-address" foreground="blue" underline="single"/>
  <style name="def:link-destination" foreground="blue" underline="single"/>
  <style name="def:link-text" foreground="cyan"/>
  <style name="def:heading" foreground="blue" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="green"/>
  <style name="def:preformatted-section" foreground="green"/>
  <style name="def:list-marker" foreground="purple" bold="true"/>
  <style name="def:deletion" strikethrough="true"/>
  <style name="def:insertion" underline="single"/>
  <style name="diff:added-line" foreground="green"/>
  <style name="diff:removed-line" foreground="red"/>
  <style name="diff:changed-line" foreground="yellow"/>
  <style name="diff:location" foreground="blue" bold="true"/>
  <style name="diff:diff-file" foreground="purple" bold="true"/>
  <style name="xml:attribute-name" foreground="yellow"/>
  <style name="xml:element-name" foreground="blue"/>
  <style name="xml:tags" foreground="blue"/>
  <style name="xml:namespace" foreground="purple"/>
  <style name="css:property-name" foreground="blue"/>
  <style name="json:keyname" foreground="blue"/>
  <style name="sh:variable" foreground="cyan"/>
  <style name="rust:lifetime" foreground="orange" italic="true"/>
  <style name="rust:attribute" foreground="yellow"/>
  <style name="rust:macro" foreground="red"/>
</style-scheme>
